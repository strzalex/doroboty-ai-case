#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$script_dir/../.." && pwd)"
cd "$root"

commit="${RALPH_COMMIT:-6c53cb0b831ebe8739c6a003e22af14902d8b0b5}"
vendor=".agent/ralph/vendor/ralph"

if [[ -d "$vendor/.git" ]]; then
  git -C "$vendor" fetch --quiet origin
else
  mkdir -p "$(dirname "$vendor")"
  git clone --quiet https://github.com/snarktank/ralph.git "$vendor"
fi

git -C "$vendor" checkout --quiet "$commit"
chmod +x "$vendor/ralph.sh"

echo "ralph installed at $vendor ($commit)"
