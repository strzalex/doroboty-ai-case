#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$script_dir/.." && pwd)"
cd "$root"

mkdir -p docs/{inbox,prds,tasks,decisions,learnings,templates}
mkdir -p .agent/{runs,ralph/runs}

missing=0
for cmd in git jq; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "missing required command: $cmd" >&2
    missing=1
  fi
done

if ! command -v just >/dev/null 2>&1; then
  echo "note: 'just' is not installed; use ./scripts/* directly or install just for shortcuts"
fi

if [[ ! -f .env && -f .env.example ]]; then
  cp .env.example .env
  echo "created .env from .env.example"
fi

find scripts -type f -maxdepth 3 -exec chmod +x {} \;

if [[ "$missing" -ne 0 ]]; then
  exit 1
fi

echo "bootstrap complete"
